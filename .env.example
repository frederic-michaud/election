# Copier en .env et adapter. Aucune de ces variables n'est nécessaire pour
# travailler en local : les valeurs par défaut suffisent.

# Mode debug — jamais activé en production.
DEBUG=1

# Obligatoire dès que DEBUG=0.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
#SECRET_KEY=

# Hôtes autorisés, séparés par des virgules.
#ALLOWED_HOSTS=politiques.ch,www.politiques.ch

# Chemin du fichier SQLite (défaut : votation.sqlite3 à la racine du dépôt).
#DB_PATH=/var/lib/politiques/votation.sqlite3

# Formulaire de contact (DEPLOIEMENT.md, § 7 ter). Le mot de passe est un
# « mot de passe d'appareil » Infomaniak, pas celui de la boîte.
#CONTACT_DESTINATAIRE=contact@politiques.ch
#DEFAULT_FROM_EMAIL=Politiques.ch <contact@politiques.ch>
#EMAIL_HOST=mail.infomaniak.com
#EMAIL_PORT=587
#EMAIL_HOST_USER=contact@politiques.ch
#EMAIL_HOST_PASSWORD=
