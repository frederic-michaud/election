# Lance la boucle du jour de scrutin, une fois, le matin du dimanche.
#
#   systemctl list-timers politiques-scrutin.timer   # quand elle démarre
#   journalctl -u politiques-scrutin.service -f      # ce qu'elle fait
#
# La date est à changer à chaque scrutin, comme DATE_SCRUTIN dans le service.

[Unit]
Description=Politiques.ch — lance le suivi du dépouillement

[Timer]
# En heure suisse : la machine est en UTC.
OnCalendar=2026-09-27 10:00 Europe/Zurich
AccuracySec=1min

[Install]
WantedBy=timers.target
